# Database
POSTGRES_DB=alocacoes
POSTGRES_USER=sigra
# Gerar: openssl rand -hex 24
POSTGRES_PASSWORD=<GERAR_SENHA_DO_BANCO>
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
TZ=America/Belem

# Backend Configuration
BACKEND_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Segredos distintos, gerados com: openssl rand -hex 32
# Em ENV=production a API não sobe com valores padrão ou com menos de 32 caracteres.
JWT_SECRET=<GERAR_COM_OPENSSL_RAND_HEX_32>
SESSION_SECRET=<GERAR_OUTRO_COM_OPENSSL_RAND_HEX_32>
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
# Senha forte e única (mín. 12 caracteres, maiúsculas, minúsculas, números e símbolos).
# Definir só para o primeiro start; depois remova do ambiente e troque a senha pelo painel.
ADMIN_SEED_PASSWORD=

# Origens do front-end autorizadas (CORS/CSRF). Em produção, somente https://
CORS_ORIGINS=["http://localhost:8080"]
# /docs e /redoc ficam desligados em produção; true só em ambiente interno de homologação
ENABLE_DOCS=false
# IPs dos proxies reversos confiáveis (para o IP real do cliente no rate limit)
FORWARDED_ALLOW_IPS=127.0.0.1

# MFA (TOTP) obrigatório para admin (3) e técnico (4)
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=<GERAR_CHAVE_FERNET>

# Cadastro público
PUBLIC_REGISTRATION_ENABLED=true
ALLOWED_EMAIL_DOMAINS=["uepa.br","aluno.uepa.br"]
# Chave secreta do Cloudflare Turnstile (obrigatória em produção com cadastro público)
TURNSTILE_SECRET_KEY=

# Google API Credentials
GOOGLE_CLIENT_ID=ID_DO_SEU_CLIENT_AQUI.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SECRET_DO_SEU_CLIENT_AQUI
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback
GOOGLE_CALENDAR_ID=primary

# Frontend Configuration
FRONTEND_PORT=8080
# URL da API vista pelo navegador (embutida no build de produção). Em produção, https://
VITE_API_URL=http://localhost:8000
# Chave pública do Turnstile (a de teste 1x00000000000000000000AA sempre passa: só para dev)
VITE_TURNSTILE_SITE_KEY=
VITE_CADASTRO_PUBLICO=true
# CSP do nginx do front: Content-Security-Policy-Report-Only (teste) ou Content-Security-Policy (bloqueio)
CSP_HEADER_NAME=Content-Security-Policy-Report-Only
# URL pública do front (OAuth Google redireciona após conectar)
FRONTEND_PUBLIC_URL=http://localhost:8080
